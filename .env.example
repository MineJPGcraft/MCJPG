# Dify Chatbot 配置
# VITE_DIFY_API_KEY: Dify 应用 API Key（Dify 控制台 → 应用接入 → API 密钥）
# VITE_DIFY_BASE_URL: Dify 服务地址
VITE_DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxx
VITE_DIFY_BASE_URL=https://dify.mcjpg.org

# Algolia Search 配置
# VITE_ALGOLIA_APP_ID: Algolia Application ID
# VITE_ALGOLIA_API_KEY: Algolia Search API Key（仅搜索权限，非 Admin Key）
VITE_ALGOLIA_APP_ID=XXXXXXXXXXXX
VITE_ALGOLIA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
